{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes AIVV Review Capability Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host",
    "surface",
    "probe_version",
    "started_at",
    "finished_at",
    "workspace_before",
    "workspace_after",
    "reviewer_packet_refs",
    "reviewer_packet_hashes",
    "isolation_result",
    "peer_output_result",
    "read_boundary_result",
    "state_write_result",
    "decision",
    "review_enabled",
    "workspace_drift",
    "safety",
    "capability_degradations",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "host": {"const": "hermes-agent"},
    "surface": {"enum": ["cli", "gateway", "unknown"]},
    "probe_version": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "workspace_before": {"type": "object"},
    "workspace_after": {"type": "object"},
    "reviewer_packet_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "hash"],
        "properties": {
          "surface": {"enum": ["cli", "gateway", "unknown"]},
          "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "reviewer_packet_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "isolation_result": {"enum": ["pass", "partial", "fail", "unverified"]},
    "peer_output_result": {"enum": ["pass", "partial", "fail", "unverified"]},
    "read_boundary_result": {"enum": ["pass", "partial", "fail", "unverified"]},
    "state_write_result": {"enum": ["pass", "partial", "fail", "unverified"]},
    "decision": {"enum": ["READY", "DEGRADED", "NOT_READY"]},
    "review_enabled": {"const": false},
    "workspace_drift": {"type": "boolean"},
    "safety": {"type": "object"},
    "capability_degradations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
