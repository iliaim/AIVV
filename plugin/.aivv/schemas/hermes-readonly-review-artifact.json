{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes AIVV Read-Only Review Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host",
    "surface",
    "artifact_kind",
    "created_at",
    "claim",
    "workspace_before",
    "workspace_after",
    "workspace_drift",
    "reviewer_packet_refs",
    "reviewer_packet_hashes",
    "real_dispatch_proof",
    "reviewer_output_refs",
    "isolation_result",
    "peer_output_result",
    "read_boundary",
    "readiness_proof_ref",
    "decision",
    "review_enabled",
    "safety",
    "capability_degradations",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "host": {"const": "hermes-agent"},
    "surface": {"enum": ["cli", "gateway", "unknown"]},
    "artifact_kind": {"const": "readonly_review_contract"},
    "created_at": {"type": "string", "minLength": 1},
    "claim": {"type": "object", "minProperties": 1},
    "workspace_before": {"type": "object"},
    "workspace_after": {"type": "object"},
    "workspace_drift": {"type": "boolean"},
    "reviewer_packet_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "hash"],
        "properties": {
          "surface": {"enum": ["cli", "gateway", "unknown"]},
          "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "reviewer_packet_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "real_dispatch_proof": {"type": "boolean"},
    "reviewer_output_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {"const": "readonly_cli_dispatch_proof_output"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "isolation_result": {"enum": ["pass", "partial", "fail", "unverified"]},
    "peer_output_result": {"enum": ["pass", "partial", "fail", "unverified"]},
    "read_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "result", "write_scope"],
      "properties": {
        "mode": {"const": "read_only"},
        "result": {"enum": ["pass", "partial", "fail", "unverified"]},
        "write_scope": {"const": "artifact_only"}
      }
    },
    "readiness_proof_ref": {"type": ["string", "null"]},
    "decision": {"enum": ["NOT_READY", "DEGRADED"]},
    "review_enabled": {"type": "boolean"},
    "safety": {"type": "object"},
    "capability_degradations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"review_enabled": {"const": true}},
        "required": ["review_enabled"]
      },
      "then": {
        "properties": {
          "surface": {"const": "cli"},
          "decision": {"const": "DEGRADED"},
          "readiness_proof_ref": {"type": "string", "minLength": 1},
          "isolation_result": {"const": "pass"},
          "peer_output_result": {"const": "pass"},
          "read_boundary": {
            "properties": {"result": {"const": "pass"}}
          },
          "safety": {
            "required": [
              "provider_model_calls",
              "network_calls",
              "delegate_task_calls",
              "tool_dispatch_calls",
              "live_profile_writes"
            ],
            "properties": {
              "provider_model_calls": {"const": "not_performed"},
              "network_calls": {"const": "not_performed"},
              "delegate_task_calls": {"const": "not_performed"},
              "tool_dispatch_calls": {"const": "not_performed"},
              "live_profile_writes": {"const": "not_performed"}
            }
          },
          "capability_degradations": {
            "anyOf": [
              {"contains": {"const": "live_reviewer_dispatch=not_performed"}},
              {"contains": {"const": "live_reviewer_dispatch=proof_injected_no_provider"}}
            ]
          },
          "evidence_refs": {
            "anyOf": [
              {"contains": {"const": "controlled-fake-reviewer-run:test-profile"}},
              {"contains": {"const": "real-dispatch-proof:test-profile-cli"}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_refs": {"contains": {"const": "real-dispatch-proof:test-profile-cli"}}
        },
        "required": ["evidence_refs"]
      },
      "then": {
        "properties": {
          "real_dispatch_proof": {"const": true},
          "reviewer_output_refs": {"minItems": 1}
        }
      }
    }
  ]
}
