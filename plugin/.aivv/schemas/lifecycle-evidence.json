{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lifecycle-evidence.json",
  "title": "AIVV Lifecycle Evidence",
  "type": "object",
  "required": [
    "id",
    "kind",
    "source_ref",
    "redacted_excerpt",
    "sha256",
    "redactions_applied",
    "publishable",
    "local_only",
    "captured_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVID-[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "enum": [
        "stderr",
        "stdout",
        "command-output",
        "file",
        "report",
        "state-log",
        "review-log",
        "fix-log",
        "test-output",
        "note"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "redacted_excerpt": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "redactions_applied": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publishable": {
      "type": "boolean"
    },
    "local_only": {
      "type": "boolean"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
