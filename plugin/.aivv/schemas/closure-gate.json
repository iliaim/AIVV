{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "closure-gate.json",
  "title": "AIVV Lifecycle Closure Gate",
  "type": "object",
  "required": [
    "status",
    "evidence_links",
    "accepted_by",
    "accepted_at",
    "rationale"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted-exception"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "accepted_by": {
            "type": "string",
            "minLength": 1
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "properties": {
    "status": {
      "enum": [
        "pending",
        "satisfied",
        "accepted-exception",
        "failed"
      ]
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accepted_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "accepted_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
