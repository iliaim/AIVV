{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident.json",
  "title": "AIVV Incident Lifecycle Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "status",
    "severity",
    "summary",
    "detected_at",
    "last_seen_at",
    "resolved_at",
    "trigger",
    "occurrence_count",
    "sensitive",
    "impact",
    "timeline",
    "evidence",
    "recurrence_key",
    "rca_status",
    "root_cause_analysis",
    "incident_context",
    "prevention_plan",
    "source_fix_ref",
    "lifecycle_evidence_refs",
    "closure_profile",
    "closure_gates",
    "links"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "closed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "closure_decision"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^INC-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "type": {
      "enum": [
        "runtime-tooling",
        "provider-dispatch",
        "viewer",
        "verification",
        "fix-regression",
        "resource-exhaustion",
        "process"
      ]
    },
    "status": {
      "enum": [
        "detected",
        "triaged",
        "mitigating",
        "resolved",
        "review-needed",
        "actions-open",
        "closed"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "review_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "sensitive": {
      "type": "boolean"
    },
    "impact": {
      "type": "object",
      "required": [
        "user_visible",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "user_visible": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ts",
          "kind",
          "summary"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "transition"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "transitioned_at",
                "transitioned_by",
                "transition_source",
                "from_status",
                "to_status"
              ]
            }
          }
        ],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "transition",
              "observed",
              "note"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "transitioned_at": {
            "type": "string",
            "format": "date-time"
          },
          "transitioned_by": {
            "type": "string",
            "minLength": 1
          },
          "transition_source": {
            "enum": [
              "auto",
              "agent",
              "user",
              "verifier",
              "external"
            ]
          },
          "from_status": {
            "anyOf": [
              {
                "$ref": "#/properties/status"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_status": {
            "$ref": "#/properties/status"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "lifecycle-evidence.json"
      }
    },
    "recurrence_key": {
      "type": "string",
      "minLength": 1
    },
    "rca_status": {
      "enum": [
        "not-started",
        "draft",
        "reviewed",
        "confirmed",
        "blocked",
        "accepted-unverified"
      ]
    },
    "root_cause_analysis": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "problem_specification": {
              "type": [
                "string",
                "null"
              ]
            },
            "surface_symptom": {
              "type": [
                "string",
                "null"
              ]
            },
            "why_1": {
              "type": [
                "string",
                "null"
              ]
            },
            "why_2": {
              "type": [
                "string",
                "null"
              ]
            },
            "why_3": {
              "type": [
                "string",
                "null"
              ]
            },
            "why_4": {
              "type": [
                "string",
                "null"
              ]
            },
            "why_5": {
              "type": [
                "string",
                "null"
              ]
            },
            "root_cause": {
              "type": [
                "string",
                "null"
              ]
            },
            "root_cause_category": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "enum": [
                "low",
                "medium",
                "high",
                null
              ]
            },
            "verification_method": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification_evidence": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence_gap": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence_gap_shape": {
              "type": [
                "string",
                "null"
              ]
            },
            "class_signature": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope_search_seed": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "incident_context": {
      "type": "object",
      "required": [
        "detection_failure",
        "contributing_factors"
      ],
      "additionalProperties": false,
      "properties": {
        "detection_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "contributing_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prevention_plan": {
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "source_fix_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "fix_id"
          ],
          "additionalProperties": false,
          "properties": {
            "fix_id": {
              "type": "string",
              "minLength": 1
            },
            "finding_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "lifecycle_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "closure_profile": {
      "enum": [
        "transient-no-action",
        "review-required",
        "prevention-required"
      ]
    },
    "closure_gates": {
      "type": "object",
      "required": [
        "rca_reviewed",
        "impact_mitigated",
        "prevention_defined"
      ],
      "additionalProperties": false,
      "properties": {
        "rca_reviewed": {
          "$ref": "closure-gate.json"
        },
        "impact_mitigated": {
          "$ref": "closure-gate.json"
        },
        "prevention_defined": {
          "$ref": "closure-gate.json"
        }
      }
    },
    "closure_decision": {
      "type": "object",
      "required": [
        "closed_at",
        "closed_by",
        "rationale",
        "evidence_links"
      ],
      "additionalProperties": false,
      "properties": {
        "closed_at": {
          "type": "string",
          "format": "date-time"
        },
        "closed_by": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "lifecycle-link.json"
      }
    }
  }
}
