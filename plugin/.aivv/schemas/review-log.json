            }
          }
        },
        "allOf": [
          {
            "oneOf": [
              {
                "required": ["file"],
                "not": {"required": ["scope_ref"]}
              },
              {
                "required": ["scope_ref"],
                "not": {
                  "anyOf": [
                    {"required": ["file"]},
                    {"required": ["line"]}
                  ]
                }
