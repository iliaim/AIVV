                "severity_rationale",
                "recommended_next_step",
                "verification_path"
              ],
              "oneOf": [
                {
                  "required": ["file"],
                  "not": {"required": ["scope_ref"]}
                },
                {
                  "required": ["scope_ref"],
                  "not": {
                    "anyOf": [
                      {"required": ["file"]},
                      {"required": ["line"]}
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "warnings": {"type": "array"},
    "runtime_evidence_ingest": {"$ref": "#/definitions/runtime_evidence_ingest"}
  },
  "allOf": [
    {
      "$comment": "Cross-property constraint (dev.40, F006): if top-level lens is a single string (homogeneous review), then findings[].lens MUST NOT be present. Schema-enforces the prose rule in skills/aivv/SKILL.md Step 7.5 'OMIT findings[].lens entirely in homogeneous-lens reviews'.",
      "if": {
