{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lifecycle-link.json",
  "title": "AIVV Lifecycle Link",
  "type": "object",
  "required": [
    "type",
    "role",
    "id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "github_issue",
              "github_pr"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          {
            "required": [
              "github"
            ],
            "properties": {
              "github": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "enum": [
        "github_issue",
        "github_pr",
        "task_issue",
        "problem_cluster",
        "incident",
        "review_log",
        "fix_log",
        "finding",
        "external_url"
      ]
    },
    "role": {
      "enum": [
        "reported-by",
        "fixes",
        "caused-by",
        "related",
        "supersedes",
        "blocked-by",
        "evidence-for",
        "created-from"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "slug": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "sync_status": {
      "enum": [
        "local-only",
        "pending-user-confirmation",
        "synced",
        "conflict",
        "sync-failed"
      ]
    },
    "github": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "host",
            "owner",
            "repo",
            "number"
          ],
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
